# ============================================================================
# HUMINT Shield - frontend environment
# Copy to .env (or .env.local) before `npm run dev` / `npm run build`.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ============================================================================

# Base URL the browser uses to reach the API.
#   - Leave as "/" when the frontend and API share an origin (nginx / vite proxy).
#   - Set an absolute URL for split deployments, e.g. https://api.example.com
VITE_API_BASE_URL=/

# Proxy target used by the Vite dev server only (never shipped to the browser).
VITE_API_PROXY=http://localhost:8000

# Optional product name override.
VITE_APP_NAME=HUMINT Shield
