# ---------------------------------------------------------------------------
# HUMINT Shield - base environment template (NO SECRETS).
#
# Copy to backend/.env and fill the values locally; .env is git-ignored.
# Environment overlays are selected with APP_ENV:
#   APP_ENV=development  -> reads .env then .env.development
#   APP_ENV=production   -> reads .env then .env.production
# Real process environment variables always win over these files.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# --- Database / cache ------------------------------------------------------
# Production: postgresql+asyncpg://humint:CHANGE_ME@postgres:5432/humint
DATABASE_URL=sqlite+aiosqlite:///./humint_shield.db
REDIS_URL=redis://localhost:6379/0
AUTO_CREATE_SCHEMA=true
AUTO_SEED=true

# --- Secrets (REQUIRED in production, >= 32 chars, hex recommended) --------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ENCRYPTION_KEY=

# --- Tokens ----------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# --- Public origins --------------------------------------------------------
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SERVE_FRONTEND=true
SHORT_LINK_BASE_URL=
SHORT_LINK_PROVIDER=vgd

# --- Reverse proxy / observability ----------------------------------------
# Enable only when the app is reachable exclusively through nginx/Cloudflare.
TRUST_PROXY_HEADERS=false
METRICS_ENABLED=false

# --- Bootstrap admin (change before first production start) ---------------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ORG_NAME=Acme Corporation
BOOTSTRAP_ORG_DOMAIN=example.com

# --- Email (Brevo API or SMTP) --------------------------------------------
EMAIL_TRANSPORT=brevo
BREVO_API_KEY=
FROM_EMAIL=security-training@example.com
FROM_NAME=Security Training
EMAIL_DRY_RUN=true
# Used only when EMAIL_TRANSPORT=smtp. SMTP_USE_SSL=false enables STARTTLS
# (typically port 587); true uses implicit TLS (typically port 465).
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true

# --- Senders (leave blank to disable the channel) --------------------------
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
WA_AKG_API_URL=http://localhost:3000/api
WA_AKG_API_KEY=
WA_AKG_SESSION_ID=
ILLYVOIP_API_KEY=
ILLYVOIP_API_BASE_URL=https://api.illyvoip.com
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
