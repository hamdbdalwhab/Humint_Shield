# ============================================================================
# HUMINT Shield - environment configuration
# Copy to .env and fill in real values. NEVER commit a real .env file.
# ============================================================================

# --- General ------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# --- Database -----------------------------------------------------------------
# Production (docker compose): asyncpg against the bundled postgres service.
DATABASE_URL=postgresql+asyncpg://humint:humint@localhost:5432/humint_shield
# Local development without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./humint_shield.db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Create tables from ORM metadata on startup and seed bootstrap data.
# Set both to false in production and let Alembic own the schema.
AUTO_CREATE_SCHEMA=true
AUTO_SEED=true

# --- Redis (Celery broker + result backend + rate limiting) -------------------
REDIS_URL=redis://localhost:6379/0

# --- Security -----------------------------------------------------------------
# Generate each with: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32
# 32-byte (64 hex char) key used for AES-256-GCM encryption at rest.
ENCRYPTION_KEY=change-me-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
BCRYPT_ROUNDS=12

# --- Email delivery (Brevo API or SMTP) ---------------------------------------
# EMAIL_TRANSPORT=brevo uses BREVO_API_KEY; EMAIL_TRANSPORT=smtp uses SMTP_*.
EMAIL_TRANSPORT=brevo
BREVO_API_KEY=your-brevo-api-key
FROM_EMAIL=security-training@example.com
FROM_NAME=Security Training
# When true the email service validates and logs but does not dispatch.
EMAIL_DRY_RUN=false
EMAIL_MAX_RETRIES=3
EMAIL_TIMEOUT_SECONDS=15
EMAIL_RETRY_BASE_DELAY=2
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true

# --- SMS delivery (TextBee Android gateway) ----------------------------------
# SMS has exactly one transport: a self-hosted or hosted TextBee Android
# gateway. Leaving TEXTBEE_API_KEY blank disables the SMS channel.
TEXTBEE_API_KEY=
# Optional device id from GET /gateway/devices. Blank resolves the default
# device at send time.
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
TEXTBEE_TIMEOUT_SECONDS=20

# --- AI template generation ---------------------------------------------------
# Any OpenAI-compatible chat-completions provider works.  LLM_PROVIDER is
# openai, groq, or custom.  Leave LLM_API_KEY blank to disable the feature with
# an explicit 503 (the endpoint never returns a mock template).
LLM_PROVIDER=openai
LLM_API_KEY=
# Optional; empty uses gpt-4o-mini for openai and llama-3.3-70b-versatile for groq.
LLM_MODEL=
# Optional comma separated models tried when the primary is rate-limited, slow,
# or returns an unusable response.  Example for Dahl:
# LLM_FALLBACK_MODELS=MiniMaxAI/MiniMax-M2.7
LLM_FALLBACK_MODELS=
# Optional; empty uses the provider default.  Required for custom providers.
LLM_BASE_URL=
# Fallback timeout, and the shorter budget for the primary model.  Keeping the
# primary budget below the public tunnel's request window lets the fallback run
# before Cloudflare returns its own 502 page.
LLM_TIMEOUT_SECONDS=60
LLM_PRIMARY_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1800

# --- Application --------------------------------------------------------------
# BASE_URL is the public origin embedded in tracking links and redirects. It
# must be reachable by recipients and by the SMS/WhatsApp/voice providers.
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
# Serve the built React dashboard from the API process, so one URL (for example a
# Cloudflare tunnel) exposes both the UI and the API. Requires frontend/dist.
SERVE_FRONTEND=true
# Optional absolute path override; empty means <repo>/frontend/dist.
FRONTEND_DIST=

# --- Rate limiting ------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=10

# --- Observability / retention ------------------------------------------------
DATA_RETENTION_DAYS=365

# --- Bootstrap admin (created on first startup) -------------------------------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ORG_NAME=Acme Corporation
BOOTSTRAP_ORG_DOMAIN=example.com
SEED_BUILTIN_TEMPLATES=true

# --- Docker Compose -----------------------------------------------------------
POSTGRES_USER=humint
POSTGRES_PASSWORD=humint
POSTGRES_DB=humint_shield
# Host ports published by compose.
HTTP_PORT=8080
API_PORT=8000
# Celery worker concurrency.
CELERY_CONCURRENCY=4

# --- IllyVoIP (real outbound vishing / Voice API) ----------------------------
# Never commit a real key. It is sent only in the X-Api-Key header.
ILLYVOIP_API_KEY=
# Documented name; ILLYVOIP_API_BASE_URL is accepted as a legacy alias.
ILLYVOIP_API_URL=https://api.illyvoip.com
# Optional. Omit to place the call from the account's main SIP identity.
ILLYVOIP_SIP_USER_ID=CHANGE_ME_SIP_USER_ID
# Optional. Omit to present the account's default verified caller ID.
ILLYVOIP_CALLER_ID=CHANGE_ME_CALLER_ID
ILLYVOIP_TIMEOUT_SECONDS=20
ILLYVOIP_ANSWER_TIMEOUT_SECONDS=45
ILLYVOIP_POLL_INTERVAL_SECONDS=2
# Voice API TTS catalog currently documents en-US only.
ILLYVOIP_TTS_LANGUAGE=en-US
ILLYVOIP_TTS_VOICE=illyvoip-emma
ILLYVOIP_TTS_CHARS_PER_SECOND=12
ILLYVOIP_TTS_PADDING_SECONDS=2
ILLYVOIP_TTS_PENDING_TIMEOUT_SECONDS=30
ILLYVOIP_MAX_SPEECH_WAIT_SECONDS=180
ILLYVOIP_WAIT_CHUNK_SECONDS=15
ILLYVOIP_RECORD_CALLS=false
# Optional sandbox scenario header; leave blank for production.
ILLYVOIP_SANDBOX_SCENARIO=

# --- WhatsApp delivery (self-hosted WA-AKG) ----------------------------------
# API root of the WA-AKG instance, including the /api prefix.
WA_AKG_API_URL=http://localhost:3000/api
# Dashboard -> API Keys. Sent as "Authorization: Bearer <key>" from the server.
WA_AKG_API_KEY=
# Dashboard -> Sessions: the session/device id created after scanning the QR.
WA_AKG_SESSION_ID=
WA_AKG_TIMEOUT_SECONDS=25
# Anti-ban pacing between two outbound WhatsApp messages (seconds).
WA_AKG_MIN_DELAY_SECONDS=10
WA_AKG_MAX_DELAY_SECONDS=30
# Optional: require this value in X-Webhook-Token on /api/v1/webhooks/whatsapp.
WA_AKG_WEBHOOK_SECRET=
