# ============================================================================
# HUMINT Shield - environment configuration
# Copy to .env and fill in real values. NEVER commit a real .env file.
# ============================================================================

# --- General ------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# --- Database -----------------------------------------------------------------
# Production (docker compose): asyncpg against the bundled postgres service.
DATABASE_URL=postgresql+asyncpg://humint:humint@localhost:5432/humint_shield
# Local development without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./humint_shield.db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Create tables from ORM metadata on startup and seed bootstrap data.
# Set both to false in production and let Alembic own the schema.
AUTO_CREATE_SCHEMA=true
AUTO_SEED=true

# --- Redis (Celery broker + result backend + rate limiting) -------------------
REDIS_URL=redis://localhost:6379/0

# --- Security -----------------------------------------------------------------
# Generate each with: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32
# 32-byte (64 hex char) key used for AES-256-GCM encryption at rest.
ENCRYPTION_KEY=change-me-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
BCRYPT_ROUNDS=12

# --- Brevo (email delivery) ---------------------------------------------------
BREVO_API_KEY=your-brevo-api-key
FROM_EMAIL=security-training@example.com
FROM_NAME=Security Training
# When true the Brevo service is put in "dry-run" mode: it validates and logs
# but does not dispatch a real message. Useful for development only.
EMAIL_DRY_RUN=false
EMAIL_MAX_RETRIES=3
EMAIL_TIMEOUT_SECONDS=15
EMAIL_RETRY_BASE_DELAY=2

# --- Vonage (SMS + WhatsApp delivery) -----------------------------------------
# Real sending is enabled only when the API key/secret and the channel sender
# are configured.  Create the key/secret in the Vonage dashboard.
VONAGE_API_KEY=your_api_key
VONAGE_API_SECRET=your_api_secret
# Alphanumeric Sender ID for SMS (or a purchased long code).
VONAGE_SMS_FROM=Vonage APIs
# WhatsApp Sandbox number (for example 14157386102) or your business number.
VONAGE_WHATSAPP_FROM=
# Optional Vonage Application credentials for JWT-authenticated WhatsApp
# Messages API calls.  Point VONAGE_PRIVATE_KEY at the downloaded private.key
# file (recommended) or paste the PEM content with escaped newlines.  Set both
# or leave both blank; blank uses API key/secret authentication.
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=
# Optional Messages API host.  WhatsApp Sandbox users set:
# VONAGE_MESSAGES_BASE_URL=https://messages-sandbox.nexmo.com
VONAGE_MESSAGES_BASE_URL=
# Optional shared secret. When set, configure the Vonage webhooks as:
#   https://YOUR_HOST/api/v1/webhooks/vonage/dlr?token=YOUR_TOKEN
#   https://YOUR_HOST/api/v1/webhooks/vonage/whatsapp-status?token=YOUR_TOKEN
VONAGE_WEBHOOK_TOKEN=

# --- AI template generation ---------------------------------------------------
# Any OpenAI-compatible chat-completions provider works.  LLM_PROVIDER is
# openai, groq, or custom.  Leave LLM_API_KEY blank to disable the feature with
# an explicit 503 (the endpoint never returns a mock template).
LLM_PROVIDER=openai
LLM_API_KEY=
# Optional; empty uses gpt-4o-mini for openai and llama-3.3-70b-versatile for groq.
LLM_MODEL=
# Optional comma separated models tried when the primary is rate-limited, slow,
# or returns an unusable response.  Example for Dahl:
# LLM_FALLBACK_MODELS=MiniMaxAI/MiniMax-M2.7
LLM_FALLBACK_MODELS=
# Optional; empty uses the provider default.  Required for custom providers.
LLM_BASE_URL=
# Fallback timeout, and the shorter budget for the primary model.  Keeping the
# primary budget below the public tunnel's request window lets the fallback run
# before Cloudflare returns its own 502 page.
LLM_TIMEOUT_SECONDS=60
LLM_PRIMARY_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1800

# --- Application --------------------------------------------------------------
# BASE_URL must be reachable by recipients and by Vonage: it is the host used
# in tracking links, the training-page redirect, and SMS delivery callbacks.
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
# Serve the built React dashboard from the API process, so one URL (for example a
# Cloudflare tunnel) exposes both the UI and the API. Requires frontend/dist.
SERVE_FRONTEND=true
# Optional absolute path override; empty means <repo>/frontend/dist.
FRONTEND_DIST=

# --- Rate limiting ------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=10

# --- Observability / retention ------------------------------------------------
DATA_RETENTION_DAYS=365

# --- Bootstrap admin (created on first startup) -------------------------------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ORG_NAME=Acme Corporation
BOOTSTRAP_ORG_DOMAIN=example.com
SEED_BUILTIN_TEMPLATES=true

# --- Docker Compose -----------------------------------------------------------
POSTGRES_USER=humint
POSTGRES_PASSWORD=humint
POSTGRES_DB=humint_shield
# Host ports published by compose.
HTTP_PORT=8080
API_PORT=8000
# Celery worker concurrency.
CELERY_CONCURRENCY=4
